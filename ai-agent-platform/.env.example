APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FAL_KEY=
FAL_LLM_MODEL=google/gemini-2.5-flash
FAL_IMAGE_MODEL=fal-ai/flux/schnell
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

SOCAPI_KEY=
SOCAPI_WEBHOOK_SECRET=
SOCAPI_BASE_URL=https://api.social-api.ai/v1
SOCAPI_REDIRECT_URI="${APP_URL}/socialapi/callback"
SOCAPI_MCP_URL=https://api.social-api.ai/mcp
SOCAPI_MCP_ENABLED=true

# AI Campaigns: slots are written and queued on SocialAPI this many minutes before they publish.
CAMPAIGNS_DRAFT_ASAP=true
CAMPAIGNS_LOOKAHEAD_MINUTES=180
CAMPAIGNS_REDISPATCH_AFTER_MINUTES=30
CAMPAIGNS_QUEUE=campaigns
CAMPAIGNS_LOG_CHANNEL=campaigns

# Wasl MCP endpoint (POST /api/mcp), requests per minute per token.
WASL_MCP_RATE_PER_MINUTE=120

# AI runtime: php (legacy AgentLoop) or sk (Microsoft Agent Framework / Semantic Kernel sidecar)
AI_RUNTIME=php
AI_RUNTIME_URL=http://127.0.0.1:8090
AI_RUNTIME_SERVICE_KEY=change-me-shared-with-laravel
AI_RUNTIME_INTERNAL_KEY=change-me-shared-with-laravel
AI_RUNTIME_TIMEOUT=200
# Quiet window before agent replies (seconds). Later msgs in same chat coalesce into one turn. 0 = off.
AI_INBOUND_DEBOUNCE_SECONDS=3
# Optional per-business cutover: AI_RUNTIME_SK_BUSINESSES=1,2
# AI_RUNTIME_PHP_BUSINESSES=

# Platform Telegram bot for merchant alerts (Settings → Integrations).
# setWebhook once: https://{APP_URL}/api/telegram/webhook/{TELEGRAM_WEBHOOK_SECRET}
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=


BROADCAST_CONNECTION=reverb
REVERB_APP_ID=wasl
REVERB_APP_KEY=wasl-key
REVERB_APP_SECRET=wasl-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
