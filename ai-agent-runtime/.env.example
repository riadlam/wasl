# Sidecar
RUNTIME_HOST=0.0.0.0
RUNTIME_PORT=8090
RUNTIME_SERVICE_KEY=change-me-shared-with-laravel
LOG_LEVEL=INFO

# OpenAI-compatible chat (Fal OpenRouter bridge or any compatible endpoint)
LLM_BASE_URL=https://fal.run/openrouter/router/openai/v1
LLM_API_KEY=
LLM_MODEL=google/gemini-2.5-flash
# Final owner-facing localization (TranslationAgent)
TRANSLATION_MODEL=google/gemini-2.5-flash
EMBEDDING_BASE_URL=https://fal.run/openrouter/router/openai/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMS=1536

# Laravel SoR
LARAVEL_BASE_URL=http://aiagent.almajdluxurytransport.com
LARAVEL_INTERNAL_KEY=change-me-shared-with-laravel

# Supabase / Postgres pgvector
SUPABASE_DB_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
SUPABASE_SCHEMA=public

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-agent-runtime
MAX_TOOL_ITERATIONS=8
SESSION_TTL_SECONDS=86400
CAPTION_APPROVER_MAX_ROUNDS=3
METACOGNITION_ENABLED=true
METACOGNITION_MAX_RETRIES=1

# Dedicated agent walkthrough log (inputs/outputs/steps only)
AGENT_ACTIVITY_LOG_ENABLED=true
AGENT_ACTIVITY_LOG_PATH=logs/agent-activity.log
# Brief one-line companion (no system prompts)
AGENT_ACTIVITY_BRIEF_LOG_PATH=logs/agent-activity-brief.log
